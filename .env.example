# Copy this file to apps/web/.env.local for local development.
# Never commit real values. Every variable here is checked in apps/web/src/lib/env-schema.ts.

# Public (sent to the browser) — no secrets here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Supabase (start it with `pnpm db:start`, then run `pnpm db:status`).
# Copy the "Publishable key" (sb_publishable_...) or, on older CLIs, the "anon key".
# NEVER use the secret / service_role key here: the app refuses to start with it.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
